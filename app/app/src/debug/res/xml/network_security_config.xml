<?xml version="1.0" encoding="utf-8"?>
<!--
    Somente nos builds de DEBUG (mockDebug/prodDebug): libera HTTP sem TLS para qualquer host,
    para o celular fisico acessar o back pelo IP da maquina na rede local (ex.: http://192.168.0.10:8080/).
    O build de release continua usando src/main/res/xml/network_security_config.xml (so 10.0.2.2/localhost).
    Em um ambiente compartilhado de verdade, use HTTPS.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="true" />
</network-security-config>
